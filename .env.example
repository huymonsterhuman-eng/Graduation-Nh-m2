# ================================================================
# LaptopWorld — Docker Compose environment variables
# ================================================================
# 1. Copy file nay thanh `.env` cung thu muc: cp .env.example .env
# 2. Sua cac gia tri thuc te ben duoi
# 3. Chay: docker compose up -d
#
# LUU Y: `.env` da gitignored — KHONG commit len git.
# ================================================================

# ---- Postgres ----
POSTGRES_PASSWORD=change_me_to_strong_password

# ---- JWT (BAT BUOC — dai >= 64 ky tu) ----
# Sinh nhanh:  openssl rand -base64 64
# Hoac vao:    https://generate-secret.vercel.app/64
JWT_SECRET=CHANGE_ME_this_is_a_very_long_placeholder_secret_key_for_hs256_algorithm_min_64_bytes_long_ok

# ---- Frontend URL ----
# Dung cho CORS allowed-origins va link trong email verify/reset password.
# Deploy public: doi thanh https://your-domain.com
APP_FRONTEND_URL=http://localhost

# ---- Gemini AI ----
# Lay API key mien phi tai: https://aistudio.google.com/apikey
# De trong → chat AI + semantic search khong hoat dong
GEMINI_API_KEY=

# ---- VNPay sandbox ----
# Dang ky tai khoan sandbox tai: https://sandbox.vnpayment.vn/devreg
# De trong → thanh toan VNPay khong hoat dong (van co the dung COD)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Return URL — khach quay ve sau khi thanh toan
# Local: http://localhost/thanh-toan/vnpay/ket-qua
# Public: https://your-domain.com/thanh-toan/vnpay/ket-qua
VNPAY_RETURN_URL=http://localhost/thanh-toan/vnpay/ket-qua

# ---- SMTP Gmail ----
# App password (khong dung mat khau tai khoan!): https://myaccount.google.com/apppasswords
# De trong → khong gui duoc email verify + reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password_16_chars
MAIL_FROM=noreply@laptopworld.local
