        { "name": "Return URL (khách redirect về, verify hash)", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/vnpay/return?vnp_TxnRef={{orderCode}}&vnp_ResponseCode=00&vnp_TransactionStatus=00&vnp_TransactionNo=14538100&vnp_Amount=100000000&vnp_SecureHash=FAKE_HASH_FOR_TEST" }, "description": "Endpoint public — không cần Bearer token, backend verify HMAC-SHA512 checksum. Với hash fake sẽ trả checksumValid=false. Với hash thật (từ VNPay redirect) sẽ trả success=true và JSON payload cho FE hiển thị page kết quả." },
        { "name": "IPN callback (VNPay server-to-server, verify + update DB)", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/vnpay/ipn?vnp_TxnRef={{orderCode}}&vnp_ResponseCode=00&vnp_TransactionStatus=00&vnp_TransactionNo=14538100&vnp_Amount=100000000&vnp_SecureHash=FAKE_HASH_FOR_TEST" }, "description": "Public endpoint VNPay gọi để confirm thanh toán. Response format {RspCode, Message} — 00=success, 97=invalid checksum, 01=order not found, 04=invalid amount, 02=already confirmed. Đây là nguồn tin cậy update orders.payment_status=paid + paymentTransactionRef + paidAt." }
      ]
    }
  ]
